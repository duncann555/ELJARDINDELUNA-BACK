{
  "name": "el-jardin-de-luna-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API mínima y segura para la tienda El Jardín de Luna.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --env-file=.env --watch index.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "admin:hash-password": "node scripts/hashAdminPassword.js",
    "migrate:canonical:apply": "node --env-file=.env scripts/migrateCanonicalData.js --apply",
    "migrate:canonical:dry": "node --env-file=.env scripts/migrateCanonicalData.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^3.2.1",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2"
  }
}
